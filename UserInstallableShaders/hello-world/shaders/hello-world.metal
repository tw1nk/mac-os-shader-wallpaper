static uint getFontRow(uint index, uint row) {
    // Each glyph is 16 rows tall, with 8 bits per row.
    // The font_data stores 4 rows in each uint, packed as 8-bit bytes.
    // For a given row:
    //   row >> 2 selects the containing uint within the glyph.
    //   row & 3 selects which of the 4 bytes inside that uint to use.
    // The selected byte is then shifted down and masked to yield one row.
    uint4 glyph = font_data[index];
    uint word = glyph[row >> 2];
    uint shift = (row & 3u) * 8u;
    return (word >> shift) & 0xFFu;
}

static float drawText(float2 p) {
    const char text[] = "WHAT IS GOING ON";
    const uint textLength = 17u;
    const uint glyphWidth = 8u;
    const uint cellWidth = 9u;
    const uint textHeight = 16u;
    const float pixelSize = 0.015;
    const float totalWidth = float(cellWidth) * float(textLength) * pixelSize - pixelSize;
    const float totalHeight = float(textHeight) * pixelSize;
    // Place the top-left of the text block at y=0.12.
    // `uv.y` is computed so that positive `iy` goes downward, matching the
    // glyph row ordering in the font table.
    float2 origin = float2(-totalWidth * 0.5, 0.12);
    float2 uv = float2((p.x - origin.x) / pixelSize, (origin.y - p.y) / pixelSize);

    int ix = int(floor(uv.x));
    int iy = int(floor(uv.y));
    if (ix < 0 || iy < 0) return 0.0;
    if (iy >= int(textHeight)) return 0.0;

    uint charIndex = uint(ix) / cellWidth;
    if (charIndex >= textLength) return 0.0;

    uint xInChar = uint(ix) % cellWidth;
    if (xInChar >= glyphWidth) return 0.0;

    uint c = uint(text[charIndex]);
    if (c < 0x20u || c > 0x7Fu) return 0.0;

    // Map the current pixel row into the glyph bitmap.
    // `iy` is the vertical row within the glyph, with 0 at the top.
    uint row = getFontRow(c - 0x20u, uint(iy));

    // Each row is stored as an 8-bit byte where bit 7 is the leftmost pixel.
    // `xInChar` is the horizontal pixel coordinate inside the glyph, so we
    // sample the MSB-first byte by shifting by (7 - xInChar).
    uint bit = (row >> (7u - xInChar)) & 1u;
    if (bit == 0u) return 0.0;

    float2 fracPos = fract(uv);
    float alpha = 1.0 - smoothstep(0.45, 0.5, max(abs(fracPos.x - 0.5), abs(fracPos.y - 0.5)));
    return alpha;
}

fragment float4 helloWorldShader(
    ShaderWallpaperVertexOut in [[stage_in]],
    constant ShaderWallpaperUniforms& u [[buffer(0)]]
) {
    float2 uv = in.texCoord;
    float2 p = (uv - 0.5) * float2(u.resolution.x / max(u.resolution.y, 1.0), 1.0) * 2.0;

    float t = u.time;


    float waves = sin((p.x + p.y) * 20.0 + t * 1.4) * 0.5 + 0.5;
    float3 skyA = float3(0.02, 0.03, 0.12);
    float3 skyB = float3(0.10, 0.00, 0.22);
    float3 color = mix(skyA, skyB, uv.y + 0.18 * waves);


    // Floating confetti bubbles.
    for (int i = 0; i < 18; i++) {
        float fi = float(i);
        float2 c = fract(float2(fi * 0.137, fi * 0.271) + float2(0.03 * sin(t * 0.23 + fi), -t * (0.018 + fi * 0.0009)));
        float radius = 0.012 + 0.018 * fract(fi * 0.37);
        float bubble = 1.0 - smoothstep(0.0, radius, distance(uv, c));
        float3 bubbleColor = 0.55 + 0.45 * cos(float3(0.0, 2.1, 4.2) + t + fi);
        color += bubble * bubbleColor * 0.35;
    }

    float glow = drawText(p + float2(0.02 * sin(t * 4.0), 0.1 * sin(t * 2.0)) * 0.98);
    float3 rainbow = 0.55 + 0.45 * cos(float3(0.0, 2.0, 4.0) + p.x * 4.0 + t * 2.0);
    color += rainbow * glow * 0.8;
   
    // Soft vignette keeps desktop edges calm.
    float vignette = smoothstep(1.25, 0.25, length(uv - 0.5));
    color *= 0.3 + 0.35 * vignette;

    return float4(color, 1.0);
}
