static float sdCircle(float2 p, float radius) {
    return length(p) - radius;
}

static float segmentDistance(float2 p, float2 a, float2 b) {
    float2 pa = p - a;
    float2 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h);
}

static float drawSegment(float2 p, float2 a, float2 b, float width) {
    return 1.0 - smoothstep(width * 0.45, width, segmentDistance(p, a, b));
}

static float drawRing(float2 p, float2 center, float radius, float width) {
    return 1.0 - smoothstep(0.0, width, abs(length(p - center) - radius));
}


